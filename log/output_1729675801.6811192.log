const rateConfig = {
  expected: 150, // 示例: 需要调整的过高期望帧率。
  min: 150,
  max: 150
};

// 修复后的代码
const rateConfig = {
  expected: 60, // 合理调整后的期望帧率。
  min: 30,
  max: 60
};

// 其他类似代码也可以根据这个模式进行修改。
```

