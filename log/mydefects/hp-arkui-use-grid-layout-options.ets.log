2024-11-11 06:31:30,786 - INFO - ```arkts
@Reusable
@Component
struct ImageItem {

  build() {
    // 显示图片的组件
    Image("image_clicked.png")
      .width('100%')
      .height(100)
      .border({ width: 2, color: 0xF9CF93 })
  }
}

@Entry
@Component
struct PhotoGalleryComponent {
  private imageDataSource: Array<string> = [];
  private irregularData: number[] = [];
  private layoutOptions: GridLayoutOptions = {
    regularSize: [1, 1],
    irregularIndexes: this.irregularData,
    getItemSize: (index: number) => {
      if ((index) % 2 === 0) {
        return [2, 1];
      }
      return [1, 1];
    }
  };

  // 初始化数据源，包含2000个图片URL
  aboutToAppear() {
    for (let i = 1; i <= 2000; i++) {
      this.imageDataSource.push(`image_${i}.png`);
    }
  }

  build() {
    Column() {
      Text('Image Gallery').fontSize(20).padding(10)

      // 使用 Grid 来显示图片列表
      Grid(undefined, this.layoutOptions) {
        LazyForEach(this.imageDataSource, (imageUrl: string) => {
          GridItem() {
            ImageItem()
          }
        }, (imageUrl: string) => imageUrl)
      }
      .cachedCount(10)
      .columnsTemplate('1fr 1fr 1fr 1fr 1fr')
      .columnsGap(10)
      .rowsGap(10)
      .width('100%')
      .height('80%')
    }
    .width('100%')
    .padding(10)
  }
}
```
