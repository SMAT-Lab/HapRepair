WaterFlow() {
  LazyForEach(this.dataSource, (item: number) => {
    FlowItem() {
      FlowItemComponent({ item: item })
    }
    .width('100%')
    .height(this.itemSizes[item % 100])
    .backgroundColor(Color.Blue)
  }, (item: string) => item)
}
.cachedCount(2)
.onReachEnd(() => {
  // 没有提前预加载新数据，滑动到结尾时才加载
  console.info("Reached end of water flow, loading more data...");
