2024-11-11 06:24:05,306 - INFO - 原始代码:
@Entry
@Component
struct ExampleComponent {
  @State boxSize: number = 100;
  @State boxOpacity: number = 1;

  resizeBox() {
    animateTo({ curve: Curve.EaseInOut, duration: 500 }, () => {
      this.boxSize = (this.boxSize === 100 ? 200 : 100);
    });
  }

  changeOpacity() {
    animateTo({ curve: Curve.EaseInOut, duration: 500 }, () => {
      this.boxOpacity = (this.boxOpacity === 1 ? 0.5 : 1);
    });
  }

  build() {
    Column() {
      Row()
        .width(this.boxSize)
        .height(this.boxSize)
        .opacity(this.boxOpacity) // Here is the line of interest
        .backgroundColor(Color.Blue)
      Button('Animate')
        .onClick(() => {
          this.resizeBox();
          this.changeOpacity();
        })
    }
    .width('100%')
    .height('100%')
  }
}

2024-11-11 06:24:05,306 - INFO - 修复后代码:
@Entry
@Component
struct ExampleComponent {
  @State boxSize: number = 100;
  @State boxOpacity: number = 1;

  build() {
    Column() {
      Row()
        .width(this.boxSize)
        .height(this.boxSize)
        .transition({
          duration: 500,
          properties: ['width', 'height', 'opacity'],
          curve: Curve.EaseInOut
        })
        .opacity(this.boxOpacity) // Updated to use transition
        .backgroundColor(Color.Blue)
      Button('Animate')
        .onClick(() => {
          this.boxSize = (this.boxSize === 100 ? 200 : 100);
          this.boxOpacity = (this.boxOpacity === 1 ? 0.5 : 1);
        })
    }
    .width('100%')
    .height('100%')
  }
}

