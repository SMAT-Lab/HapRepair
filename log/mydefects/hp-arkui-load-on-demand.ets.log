2024-11-11 06:24:41,372 - INFO - 原始代码:
@Entry
@Component
struct LargeListComponent {
  @State items: string[] = [
    'Apple', 'Banana', 'Orange', 'Grapes', 'Mango', 'Pineapple', 'Strawberry', 
    'Blueberry', 'Watermelon', 'Peach', 'Cherry', 'Papaya', 'Kiwi', 'Lychee', 
    'Pear', 'Plum', 'Apricot', 'Pomegranate', 'Dragonfruit', 'Cantaloupe'
  ];

  build() {
    List() {
      // 在长列表中使用ForEach而非LazyForEach，可能导致滑动丢帧
      ForEach(this.items, (item: string) => {
        ListItem() {
          Text(item)
        }
      }, (item: string) => item)
    }
    .width('100%')
    .height('100%')
  }
}

2024-11-11 06:24:41,373 - INFO - 修复后代码:
@Entry
@Component
struct LargeListComponent {
  private items: DataSource = new DataSource([
    'Apple', 'Banana', 'Orange', 'Grapes', 'Mango', 'Pineapple', 'Strawberry', 
    'Blueberry', 'Watermelon', 'Peach', 'Cherry', 'Papaya', 'Kiwi', 'Lychee', 
    'Pear', 'Plum', 'Apricot', 'Pomegranate', 'Dragonfruit', 'Cantaloupe'
  ]);

  build() {
    List() {
      // 在长列表中建议使用LazyForEach以避免滑动时掉帧
      LazyForEach(this.items, (item: string) => {
        ListItem() {
          Text(item)
        }
      }, (item: string) => item)
    }
    .width('100%')
    .height('100%')
  }
}

