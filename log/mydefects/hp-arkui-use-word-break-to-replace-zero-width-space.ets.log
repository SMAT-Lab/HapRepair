@Entry
@Component
struct MyComponent {
  private longText: string = 'ThisIsAVeryLongTextWithoutSpaces';

  build() {
    // 使用word-break属性来处理文本换行
    Text(this.longText)
      .fontSize(16)
      .padding(10)
