interface GeneratedObjectLiteralInterface_1 {
  timeout: number;
  retries: number;
}

let config: GeneratedObjectLiteralInterface_1 = {
  timeout: 5000,
  retries: 3,
};

function fetchData(cfg: GeneratedObjectLiteralInterface_1) {
  // 使用参数传递 config
  console.log(`Fetching data with timeout: ${cfg.timeout}ms and retries: ${cfg.retries}`);

  // 模拟一些操作
  return cfg.timeout * cfg.retries;
}

fetchData(config);
