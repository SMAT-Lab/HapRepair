```arkts
import i18n from '@ohos.i18n';

// 手动设置时区，不通过标准接口获取时间信息
let timeZone = '123';
let calendar = i18n.getCalendar(i18n.getSystemLocale());
calendar.setTimeZone(timeZone);

// 获取时区偏移和DST（夏令时）偏移
let zoneOffset = calendar.get('zone_offset');  // 获取时区偏移
let dstOffset = calendar.get('dst_offset');  // 获取夏令时偏移

```
