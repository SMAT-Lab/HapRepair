import media from '@ohos.multimedia.media';

@Entry
@Component
struct MyComponent {
  private avPlayer: media.AVPlayer | undefined = undefined;

  aboutToAppear(): void {
    // 每次进入页面时都会创建一个新的 AVPlayer 实例，未缓存
    media.createAVPlayer().then((ret) => {
      this.avPlayer = ret;
    })
  }

  aboutToDisappear(): void {
    // 每次离开页面时销毁 AVPlayer 实例
    if (this.avPlayer) {
      this.avPlayer.release();  // 释放播放器资源
    }
    this.avPlayer = undefined;
  }

  playVideo(): void {
    // 每次播放前都要等待创建播放器实例
    if (this.avPlayer) {
      this.avPlayer.setMediaSource('path/to/video/file');
      this.avPlayer.play();
    }
  }

  build() {
    Column() {
      Button("播放视频")
        .onClick(() => {
          this.playVideo();  // 点击时播放视频
        })
        .width('100%')
        .height(50)
    }
  }
}

2024-11-11 07:35:28,130 - INFO - 修复后代码:
import media from '@ohos.multimedia.media';

@Entry
@Component
struct MyComponent {
  private avPlayer: media.AVPlayer | undefined = undefined;
  private avPlayerManager: AVPlayerManager = AVPlayerManager.getInstance();

  aboutToAppear(): void {
    // 使用缓存的 AVPlayer 实例
    this.avPlayerManager.switchPlayer();
    this.avPlayer = this.avPlayerManager.getCurrentPlayer();
  }

  aboutToDisappear(): void {
    // 重置 AVPlayer 实例而非销毁
    this.avPlayerManager.resetCurrentPlayer();
    this.avPlayer = undefined;
  }

  playVideo(): void {
    // 每次播放前都要等待创建播放器实例
    if (this.avPlayer) {
      this.avPlayer.setMediaSource('path/to/video/file');
      this.avPlayer.play();
    }
  }

  build() {
    Column() {
      Button("播放视频")
        .onClick(() => {
          this.playVideo();  // 点击时播放视频
        })
        .width('100%')
        .height(50)
    }
  }
}

class AVPlayerManager {
  private static instance?: AVPlayerManager;

  private player1?: media.AVPlayer;
  private player2?: media.AVPlayer;
  private currentPlayer?: media.AVPlayer;

  private constructor() {
    // 初始化 AVPlayer 实例
    media.createAVPlayer().then((player) => {
      this.player1 = player;
    });
    media.createAVPlayer().then((player) => {
      this.player2 = player;
    });
  }

  public static getInstance(): AVPlayerManager {
    if (!AVPlayerManager.instance) {
      AVPlayerManager.instance = new AVPlayerManager();
    }
    return AVPlayerManager.instance;
  }

  switchPlayer(): void {
    this.currentPlayer = this.currentPlayer === this.player1 ? this.player2 : this.player1;
  }

  getCurrentPlayer(): media.AVPlayer | undefined {
    return this.currentPlayer;
  }

  resetCurrentPlayer(): void {
    this.currentPlayer?.pause(() => {
      this.currentPlayer?.reset();
    });
  }
}

