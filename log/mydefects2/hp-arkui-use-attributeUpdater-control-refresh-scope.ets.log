@Reusable
@Component
struct ColorBox {
  @State color: string = "#FFFFFF";  // 颜色状态变量
  aboutToReuse(params: Record<string, Object>): void {
    this.color = params.color as string;
  }
  build() {
    Text('颜色方块')
      .fontSize(16)
      .padding(5)
      .attributeUpdater('backgroundColor', () => this.color, this.color)
      .attributeUpdater('borderColor', () => this.color, this.color)
      .borderWidth(2)
      .borderStyle(BorderStyle.Solid)
      .width(50)
      .height(50)
  }
}

