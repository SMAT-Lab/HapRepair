@Entry
@Component
struct DashboardComponent {
  @State userStats: number[] = Array.from(Array(10), (_, i) => i + 1);

  build() {
    Column() {
      List() {
        LazyForEach(this.userStats, (stat: number) => {
          ListItem() {
            // 使用自定义的 UserInfo 组件嵌套渲染
            UserInfo({ stat: stat })
          }
        }, (stat: number) => stat.toString())
      }
      .cachedCount(2)
      .width('100%')
      .height('100%')
    }
  }
}

@Reusable
@Component
struct UserInfo {
  @State @Watch('aboutToReuse') stat: number = 0;

  aboutToReuse(params: ESObject): void {
    this.stat = params.stat as number;
  }

  build() {
    Column() {
      renderUserDetails(this.stat)
    }
    .width('100%')
    .height(100)
    .padding(10)
  }
}

@Builder
function renderUserDetails(stat: number) {
  Row() {
    UserStatsDisplay({ stat: stat })
  }
  .padding(5)
}

@Component
struct UserDetails {
  @State @Watch('aboutToReuse') stat: number = 0;

  aboutToReuse(params: ESObject): void {
    this.stat = params.stat as number;
  }

  build() {
    Row() {
      // 嵌套第三个自定义组件 UserStatsDisplay
      UserStatsDisplay({ stat: this.stat })
    }
    .padding(5)
  }
}

@Component
struct UserStatsDisplay {
  @State @Watch('onStatChange') stat: number = 0;

  aboutToReuse(params: ESObject): void {
    this.stat = params.stat as number;
  }
  
  onStatChange() {
    // Additional logic handling if needed when stat changes
  }

  build() {
    Column() {
      Text('用户统计: ' + this.stat)
        .fontSize(20)
        .fontWeight(20)
    }
    .width('100%')
    .height(50)
  }
}
