```arkts
@Entry
@Component
struct MyComponent {
  private longText: string = 'ThisIsAVeryLongTextWithoutSpaces';

  build() {
    // 使用word-break样式替代零宽空格换行
    Text(this.longText)
      .fontSize(16)
      .padding(10)
      .textAlign(TextAlign.Start)
      .style({ 'word-break': 'break-all' })
  }
}
