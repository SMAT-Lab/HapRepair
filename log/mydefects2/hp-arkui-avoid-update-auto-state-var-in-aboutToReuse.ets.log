// 避免在aboutToReuse中对自动更新值的状态变量进行更新。
// 通用丢帧场景下，建议优先修改。

@Reusable
@Component
struct UserProfileComponent {
  @State name: string = '';
  @State age: number = 0;
  @Link email: string;

  aboutToReuse(params: Record<string, Object>): void {
    // 不建议在此处更新自动更新的状态变量
    this.name = params.name as string;
    this.age = params.age as number;
    this.email = params.email as string;
  }

  build() {
    Column() {
      Text('姓名: ' + this.name)
        .fontSize(24)
      Text('年龄: ' + this.age)
        .fontSize(24)
      Text('邮箱: ' + this.email)
        .fontSize(24)
    }
  }
}

