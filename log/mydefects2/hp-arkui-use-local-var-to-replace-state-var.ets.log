@Entry
@Component
struct CounterComponent {
  @State counter: number = 0;
  incrementMultipleTimes() {
    for (let i = 0; i < 5; i++) {
      this.counter += 1;
      this.counter += 2;
      this.counter += 3;
    }
  }
  build() {
    Column() {
      Text('Counter: ' + this.counter)
        .fontSize(20)
        .padding(10)
      Button('Increase Counter')
        .onClick(() => {
          this.incrementMultipleTimes();
        })
        .fontSize(16)
        .backgroundColor(Color.Gray)
        .padding(10)
    }
    .padding(20)
  }
}

2024-11-11 07:37:19,439 - INFO - 修复后代码:
@Entry
@Component
struct CounterComponent {
  @State counter: number = 0;
  incrementMultipleTimes() {
