@Entry
@Component
struct MainScreen {
  private lastScrollXOffset: number = 0;
  private lastScrollYOffset: number = 0;

  build() {
    Scroll(this.scroller) {
      Column() {
        // Your content here
      }.width('100%')
    }
    .scrollable(ScrollDirection.Vertical)
    .scrollBar(BarState.On)
    .scrollBarColor(Color.Gray)
    .scrollBarWidth(30)
    .onScroll((xOffset: number, yOffset: number) => {
      this.lastScrollXOffset = xOffset;
      this.lastScrollYOffset = yOffset;
      console.info(`Scroll Offset: X=${xOffset}, Y=${yOffset}`);
    })
