**修复代码:**
```arkts
@Entry
@Component
struct App {
  scroller = new Scrollable()

  build() {
    Scroll(this.scroller) {
      
    }
    .scrollable(ScrollDirection.Vertical)
    .scrollBar(BarState.On)
    .scrollBarColor(Color.Gray)
    .scrollBarWidth(30)
    .onScroll((xOffset: number, yOffset: number) => {
      // 简单的变量赋值，避免直接打印日志
      const scrollLog = `${xOffset} ${yOffset}`;
      console.log(scrollLog); // 如果需要调试，可以使用 console.log
    })
    .onScrollEdge((side: Edge) => {
      // 简单的变量赋值，避免直接打印日志
      const edgeLog = 'To the edge';
      console.info(edgeLog); // 如果需要记录，可以使用 console.info
    })
    .onScrollEnd(() => {
      // 简单的变量赋值，避免直接打印日志
