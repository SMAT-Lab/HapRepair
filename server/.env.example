# 应用配置
DEBUG=False
HOST=0.0.0.0
PORT=8000

# API密钥配置
OPENAI_API_KEY=***REMOVED***
OPENAI_API_BASE=https://xiaoai.plus/v1

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Pinecone向量数据库配置
PINECONE_API_KEY=***REMOVED***
PINECONE_INDEX_NAME=arkts-1536

# 模型配置
DEFAULT_MODEL=gpt-4o-mini
MODEL_CACHE_DIR=/home/models
EMBEDDING_MODEL=dunzhang/stella_en_1.5B_v5

# 修复配置
MAX_REPAIR_ROUNDS=5
DEFAULT_REPAIR_MODE=single
ENABLE_RAG=True

# 批处理配置
MAX_BATCH_SIZE=100
BATCH_TIMEOUT=3600

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=

# CORS配置（用逗号分隔多个域名）
CORS_ORIGINS=*

# 限流配置
RATE_LIMIT_PER_MINUTE=60